+  fn resolve_patchelf_bin() -> Option<PathBuf> {
+    if let Ok(path) = std::env::var("DONUT_PATCHELF_BIN") {
+      let path = PathBuf::from(path);
+      if path.exists() {
+        return Some(path);
+      }
+    }
+
+    let Ok(path_var) = std::env::var("PATH") else {
+      return None;
+    };
+
+    std::env::split_paths(&path_var)
+      .map(|dir| dir.join("patchelf"))
+      .find(|path| path.exists())
+  }
+
+  fn read_elf_interpreter(
+    patchelf_bin: &Path,
+    path: &Path,
+  ) -> Result<Option<String>, Box<dyn std::error::Error + Send + Sync>> {
+    let output = Command::new(patchelf_bin)
+      .arg("--print-interpreter")
+      .arg(path)
+      .output()?;
+
+    if !output.status.success() {
+      return Ok(None);
+    }
+
+    let interpreter = String::from_utf8_lossy(&output.stdout).trim().to_string();
+    if interpreter.is_empty() {
+      Ok(None)
+    } else {
+      Ok(Some(interpreter))
+    }
+  }
+
+  fn patch_elf_interpreter(
+    patchelf_bin: &Path,
+    path: &Path,
+    target_interpreter: &str,
+  ) -> Result<bool, Box<dyn std::error::Error + Send + Sync>> {
+    let Some(current_interpreter) = read_elf_interpreter(patchelf_bin, path)? else {
+      return Ok(false);
+    };
+
+    if current_interpreter == target_interpreter {
+      return Ok(false);
+    }
+
+    let output = Command::new(patchelf_bin)
+      .arg("--set-interpreter")
+      .arg(target_interpreter)
+      .arg(path)
+      .output()?;
+
+    if !output.status.success() {
+      return Err(
+        format!(
+          "Failed to patch ELF interpreter for {}: {}",
+          path.display(),
+          String::from_utf8_lossy(&output.stderr)
+        )
+        .into(),
+      );
+    }
 
