+  pub(crate) fn create_linux_command(
+    executable_path: &Path,
+    args: &[String],
+  ) -> Result<Command, Box<dyn std::error::Error + Send + Sync>> {
+    prepare_linux_browser_runtime(executable_path)?;
+
+    log::info!(
+      "Launching {} directly after Linux runtime preparation",
+      executable_path.display()
+    );
+
+    let mut cmd = Command::new(executable_path);
+    cmd.args(args);
+
+    let library_path = collect_linux_library_path(executable_path);
+    for action in collect_common_linux_env(library_path.as_deref()) {
+      match action {
+        LinuxEnvAction::Set(key, value) => {
+          cmd.env(key, value);
+        }
+        LinuxEnvAction::Remove(key) => {
+          cmd.env_remove(key);
+        }
+      }
     }
 
+    Ok(cmd)
+  }
